{
  // A separate, tiny deployment from the main penpigeon site: the review shell,
  // the twelve designs, and a Worker that collects ratings. Run every wrangler
  // command from inside this folder.
  "name": "penpigeon-design-review",
  "main": "worker.js",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // The Worker only runs for the API; everything else is a plain static file.
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // No database_id on purpose: wrangler creates the database on first deploy.
  // If your wrangler version asks for one, see README.md.
  "d1_databases": [
    { "binding": "DB", "database_name": "penpigeon-design-review" }
  ]
}
